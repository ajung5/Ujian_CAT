{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format:php": "prettier --write \"app/**/*.php\" \"bootstrap/*.php\" \"config/**/*.php\" \"database/**/*.php\" \"routes/**/*.php\" \"tests/**/*.php\"",
        "format:blade": "npm run format:blade:prettier && npm run format:blade:cleanup",
        "format:frontend": "prettier --write \"resources/js/**/*.{js,ts,jsx,tsx}\" \"resources/css/**/*.{css,scss}\" --ignore-unknown",
        "format": "npm run format:php && npm run format:blade && npm run format:frontend",
        "format:check": "npm run format:check:blade-whitespace && npm run format:check:prettier",
        "format:blade:prettier": "prettier --write \"resources/views/**/*.blade.php\"",
        "format:blade:cleanup": "python3 scripts/cleanup_blade_whitespace.py",
        "format:check:blade-whitespace": "python3 scripts/cleanup_blade_whitespace.py --check",
        "format:check:prettier": "prettier --check \"app/**/*.php\" \"bootstrap/*.php\" \"config/**/*.php\" \"database/**/*.php\" \"routes/**/*.php\" \"tests/**/*.php\" \"resources/views/**/*.blade.php\" \"resources/js/**/*.{js,ts,jsx,tsx}\" \"resources/css/**/*.{css,scss}\" --ignore-unknown"
    },
    "devDependencies": {
        "@prettier/plugin-php": "0.25.0",
        "@shufo/prettier-plugin-blade": "1.16.2",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "3.9.8",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
